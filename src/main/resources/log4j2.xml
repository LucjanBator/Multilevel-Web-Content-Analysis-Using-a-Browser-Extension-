<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
        </Console>
        <Console name="CleanConsole" target="SYSTEM_OUT">
            <PatternLayout pattern="%msg%n"/>
        </Console>
        <File name="File" fileName="logs/app.log">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
        </File>
    </Appenders>
    <Loggers>
        <Root level="info">
            <AppenderRef ref="Console"/>
        </Root>
        <Logger name="extension.MainApp" level="INFO" additivity="false">
            <AppenderRef ref="CleanConsole"/>
        </Logger>
        <Logger name="extension.core" level="INFO" additivity="false">
            <AppenderRef ref="CleanConsole"/>
        </Logger>
        <Logger name="extension.exceptions" level="INFO" additivity="false">
            <AppenderRef ref="CleanConsole"/>
        </Logger>
        <Logger name="extension.services" level="INFO" additivity="false">
            <AppenderRef ref="CleanConsole"/>
        </Logger>
        <Logger name="extension.utils" level="INFO" additivity="false">
            <AppenderRef ref="CleanConsole"/>
        </Logger>
        <Logger name="extension.service.SessionManager" level="INFO" additivity="false">
            <AppenderRef ref="CleanConsole"/>
        </Logger>
        <Logger name="extension.core.WebDriverFactory" level="INFO" additivity="false">
            <AppenderRef ref="CleanConsole"/>
        </Logger>
        <Logger name="extension.core.config.AppConfig" level="INFO" additivity="false">
            <AppenderRef ref="CleanConsole"/>
        </Logger>
        <Logger name="extension.service.ScrapingService" level="INFO" additivity="false">
            <AppenderRef ref="CleanConsole"/>
        </Logger>
        <Logger name="extension.service.PerformanceMonitor" level="INFO" additivity="false">
            <AppenderRef ref="CleanConsole"/>
        </Logger>
        <Logger name="extension.service.GeminiClient" level="INFO" additivity="false">
            <AppenderRef ref="CleanConsole"/>
        </Logger>
        <Logger name="extension.service.LlamaClient" level="INFO" additivity="false">
            <AppenderRef ref="CleanConsole"/>
        </Logger>
        <Logger name="extension.service.OpenAIClient" level="INFO" additivity="false">
            <AppenderRef ref="CleanConsole"/>
        </Logger>
        <Logger name="extension.service.AIClient" level="INFO" additivity="false">
            <AppenderRef ref="CleanConsole"/>
        </Logger>
        <Logger name="org.openqa.selenium.devtools.CdpVersionFinder" level="error" />
        <Logger name="org.openqa.selenium.chromium.ChromiumDriver" level="error" />
    </Loggers>
</Configuration>
